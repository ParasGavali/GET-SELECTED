<%- include('../partials/head') %>
<%- include('../partials/header-app') %>
<main>
  <div class="app-main" style="max-width:960px">
    <%- include('../partials/flash') %>
    <div class="page-head">
      <h1>My Profile</h1>
      <p>Your preparation profile.</p>
    </div>

    <div class="grid grid-2" style="grid-template-columns:1fr 1.6fr">
      <div style="display:grid;gap:20px">
        <div class="card">
          <div class="card-body text-center">
            <span class="avatar" style="width:72px;height:72px;font-size:28px;background:<%= user.avatarColor %>"><%= user.name.charAt(0).toUpperCase() %></span>
            <h2 style="font-size:19px;margin-top:12px"><%= user.name %></h2>
            <p class="muted small"><%= user.email %></p>
            <p class="small mt-1"><%= user.college || '—' %><% if (user.branch) { %> · <%= user.branch %><% } %><% if (user.year) { %> · <%= user.year %><% } %></p>
            <% if (user.role === 'admin') { %><span class="badge badge-warning mt-1">Admin</span><% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h2>Preparation Stats</h2></div>
          <div class="card-body grid grid-2" style="gap:12px">
            <div class="result-stat"><b><%= stats.tests %></b><span>Tests Completed</span></div>
            <div class="result-stat"><b><%= stats.questions %></b><span>Questions Solved</span></div>
            <div class="result-stat"><b><%= stats.coding %></b><span>Coding Solved</span></div>
            <div class="result-stat"><b><%= stats.accuracy %>%</b><span>Accuracy</span></div>
            <div class="result-stat"><b><%= stats.rank ? '#' + stats.rank : '—' %></b><span>Overall Rank</span></div>
            <div class="result-stat"><b style="color:var(--accent)"><%= stats.streak %></b><span>Day Streak</span></div>
          </div>
        </div>
      </div>

      <div style="display:grid;gap:20px">
        <div class="card">
          <div class="card-header"><h2>Edit Profile</h2></div>
          <div class="card-body">
            <form action="/profile" method="POST">
              <div class="form-group">
                <label>Name</label>
                <input type="text" name="name" class="form-control" required value="<%= user.name %>">
              </div>
              <div class="form-group">
                <label>College</label>
                <div class="college-select-wrap">
                  <input type="text" id="collegeSearch" class="form-control" placeholder="Search your college..." autocomplete="off" value="<%= user.college || '' %>">
                  <input type="hidden" id="collegeId" name="collegeId" value="<%= user.collegeId || '' %>">
                  <input type="hidden" id="collegeName" name="college" value="<%= user.college || '' %>">
                  <div id="collegeDropdown" class="college-dropdown" style="display:none"></div>
                </div>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label>Branch</label>
                  <input type="text" name="branch" class="form-control" value="<%= user.branch %>">
                </div>
                <div class="form-group">
                  <label>Year</label>
                  <select name="year" class="form-control">
                    <option value="">Select</option>
                    <% [1,2,3,4,5].forEach(function(y) { %><option value="<%= y %>" <%= user.year === y ? 'selected' : '' %>><%= y %>th</option><% }) %>
                  </select>
                </div>
              </div>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </form>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h2>Change Password</h2></div>
          <div class="card-body">
            <form action="/profile/password" method="POST">
              <div class="form-group">
                <label>Current Password</label>
                <input type="password" name="currentPassword" class="form-control" required>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label>New Password</label>
                  <input type="password" name="newPassword" class="form-control" required minlength="8">
                </div>
                <div class="form-group">
                  <label>Confirm New Password</label>
                  <input type="password" name="confirmPassword" class="form-control" required minlength="8">
                </div>
              </div>
              <button type="submit" class="btn btn-outline">Update Password</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<script>
(function() {
  var input = document.getElementById('collegeSearch');
  if (!input) return;
  var hiddenId = document.getElementById('collegeId');
  var hiddenName = document.getElementById('collegeName');
  var dropdown = document.getElementById('collegeDropdown');
  var colleges = <%- JSON.stringify(typeof colleges !== 'undefined' ? colleges : []) %>;
  var debounce = null;

  input.addEventListener('focus', function() { filterColleges(input.value); });
  input.addEventListener('input', function() {
    hiddenId.value = '';
    hiddenName.value = input.value;
    clearTimeout(debounce);
    debounce = setTimeout(function() { filterColleges(input.value); }, 150);
  });
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.college-select-wrap')) dropdown.style.display = 'none';
  });

  function filterColleges(query) {
    var q = (query || '').toLowerCase().trim();
    var matches = [];
    if (q.length > 0) {
      matches = colleges.filter(function(c) {
        return c.officialName.toLowerCase().indexOf(q) !== -1 ||
               c.shortName.toLowerCase().indexOf(q) !== -1 ||
               c.city.toLowerCase().indexOf(q) !== -1 ||
               (c.aliases && c.aliases.some(function(a) { return a.toLowerCase().indexOf(q) !== -1; }));
      }).slice(0, 8);
    }
    if (q === '' || matches.length > 0) {
      matches.push({ officialName: 'Other (Not Listed)', slug: 'other', shortName: 'Other', city: '', _isOther: true });
    }
    renderDropdown(matches);
  }

  function renderDropdown(items) {
    if (!items.length) { dropdown.style.display = 'none'; return; }
    dropdown.innerHTML = items.map(function(c) {
      return '<div class="college-option" data-id="' + (c._isOther ? '' : c._id || c.slug) + '" data-name="' + (c._isOther ? '' : c.officialName) + '">' +
        '<span class="college-option-name">' + c.officialName + '</span>' +
        (c.city ? '<span class="college-option-city">' + c.city + '</span>' : '') +
      '</div>';
    }).join('');
    dropdown.style.display = 'block';
    dropdown.querySelectorAll('.college-option').forEach(function(el) {
      el.addEventListener('click', function() {
        var id = el.getAttribute('data-id');
        var name = el.getAttribute('data-name');
        hiddenId.value = id;
        hiddenName.value = name || input.value;
        input.value = name || '';
        dropdown.style.display = 'none';
      });
    });
  }

  filterColleges(input.value);
})();
</script>
<%- include('../partials/footer') %>
