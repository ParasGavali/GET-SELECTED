<%- include('../partials/head') %>
<%- include('../partials/header-app') %>
<main>
  <div class="app-main" style="max-width:860px">
    <%- include('../partials/flash') %>
    <div class="page-head flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1>Practice Session</h1>
        <p id="sessionMeta"><%= questions.length %> questions · Practice. Prepare. Get Selected.</p>
      </div>
      <a href="/practice" class="btn btn-ghost btn-sm">End Session</a>
    </div>

    <div class="card" style="margin-bottom:16px">
      <div class="card-body" style="padding:14px 20px">
        <div class="flex items-center justify-between mb-1">
          <span class="small fw-600" id="progressLabel">Question 1 of <%= questions.length %></span>
          <span class="badge badge-success" id="correctCount">0 correct</span>
        </div>
        <div class="progress"><div class="progress-bar" id="progressBar" style="width:0%"></div></div>
      </div>
    </div>

    <div id="questionArea"></div>
  </div>
</main>

<script>
(function () {
  var questions = <%- JSON.stringify(questions.map(function(q) {
    return { id: String(q._id), text: q.text, options: q.options, topic: q.topic ? q.topic.name : '', subject: q.subject ? q.subject.name : '', subjectColor: q.subject ? q.subject.color : '#4f46e5' };
  })) %>;
  var bookmarkIds = <%- JSON.stringify(bookmarkIds) %>;
  var current = 0;
  var answers = {};      // qid -> selected index
  var timeOnQuestion = {}; // qid -> ms spent
  var lastTimestamp = Date.now();
  var correctCount = 0;
  var reviewData = null;
  var area = document.getElementById('questionArea');

  function render() {
    if (reviewData) return renderReview();
    var q = questions[current];
    var sel = answers[q.id];
    var prev = answers[q.id] !== undefined;
    var marked = bookmarkIds.indexOf(q.id) >= 0;

    var html = '';
    html += '<div class="card">';
    html += '<div class="card-body">';
    html += '<div class="flex items-center justify-between mb-2">';
    html += '<span class="badge" style="background:' + q.subjectColor + ';color:#fff">' + q.subject + '</span>';
    html += '<div>';
    html += '<button type="button" class="btn-link btn-sm" data-bookmark data-item-type="question" data-item-id="' + q.id + '" ' + (marked ? 'style="color:#d97706"' : '') + '><i data-lucide="bookmark" ' + (marked ? 'fill="currentColor"' : '') + '></i> ' + (marked ? 'Saved' : 'Save') + '</button>';
    html += '</div></div>';
    html += '<div class="q-number">' + q.topic + '</div>';
    html += '<div class="q-text">' + q.text + '</div>';

    var letters = ['A', 'B', 'C', 'D'];
    if (prev) {
      var correctOpt = <%- JSON.stringify(questions.map(function(q) { return q.correctOption; })) %>[current];
      var isCorrect = sel === correctOpt;
      q.options.forEach(function(opt, i) {
        var cls = 'review-opt ';
        if (i === correctOpt) cls += 'is-correct ';
        if (i === sel && !isCorrect) cls += 'user-wrong ';
        if (i === sel && isCorrect) cls += 'user-selected-correct ';
        html += '<div class="' + cls + '">' + letters[i] + '. ' + opt + '</div>';
      });
      html += '<div class="explanation"><b>Explanation:</b> ' + (<%- JSON.stringify(questions.map(function(q) { return q.explanation; })) %>[current] || 'No explanation available.') + '</div>';
      html += '<div class="mt-2"><span class="badge ' + (isCorrect ? 'badge-success' : 'badge-danger') + '">' + (isCorrect ? 'Correct' : 'Incorrect') + '</span></div>';
    } else {
      q.options.forEach(function(opt, i) {
        html += '<div class="q-option" data-opt="' + i + '"><span class="opt-label">' + letters[i] + '.</span><span>' + opt + '</span></div>';
      });
    }
    html += '</div></div>';

    html += '<div class="flex items-center justify-between mt-3">';
    html += '<button type="button" class="btn btn-outline" id="btnPrev" ' + (current === 0 ? 'disabled' : '') + '>Previous</button>';
    if (prev || current === questions.length - 1) {
      html += '<button type="button" class="btn btn-primary" id="btnNext">' + (current === questions.length - 1 ? 'Finish & See Result' : 'Next') + '</button>';
    }
    html += '</div>';

    area.innerHTML = html;
    window.GS && GS.initIcons && GS.initIcons();
    document.querySelectorAll('[data-bookmark]').forEach(function(b) {
      b.addEventListener('click', toggleBookmark);
    });
    document.querySelectorAll('.q-option').forEach(function(el) {
      el.addEventListener('click', function() { selectAnswer(parseInt(el.dataset.opt, 10)); });
    });
    var prevBtn = document.getElementById('btnPrev');
    if (prevBtn) prevBtn.addEventListener('click', function() { trackTime(); current--; render(); });
    var nextBtn = document.getElementById('btnNext');
    if (nextBtn) nextBtn.addEventListener('click', function() { trackTime(); if (current === questions.length - 1) finish(); else { current++; render(); } });
    lastTimestamp = Date.now();
    document.getElementById('progressBar').style.width = Math.round((current / questions.length) * 100) + '%';
    document.getElementById('progressLabel').textContent = 'Question ' + (current + 1) + ' of ' + questions.length;
  }

  function trackTime() {
    var q = questions[current];
    var spent = Date.now() - lastTimestamp;
    timeOnQuestion[q.id] = (timeOnQuestion[q.id] || 0) + spent;
  }

  function selectAnswer(i) {
    var q = questions[current];
    if (answers[q.id] === undefined && i === (<%- JSON.stringify(questions.map(function(q) { return q.correctOption; })) %>[current])) correctCount++;
    if (answers[q.id] !== undefined) return;
    answers[q.id] = i;
    document.getElementById('correctCount').textContent = correctCount + ' correct';
    render();
  }

  function toggleBookmark(e) {
    var btn = e.currentTarget;
    fetch('/api/bookmark/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ itemType: 'question', itemId: btn.dataset.itemId })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.bookmarked) { bookmarkIds.push(btn.dataset.itemId); GS.toast('Saved', 'success'); }
      else { bookmarkIds = bookmarkIds.filter(function(x) { return x !== btn.dataset.itemId; }); GS.toast('Removed from saved'); }
      render();
    });
  }

  function finish() {
    var payload = questions.map(function(q) {
      return { question: q.id, selected: answers[q.id] !== undefined ? answers[q.id] : null, timeSpent: Math.round((timeOnQuestion[q.id] || 0) / 1000) };
    });
    var btn = document.querySelector('#questionArea .btn-primary');
    if (btn) { btn.disabled = true; btn.textContent = 'Submitting...'; }
    fetch('/api/practice/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ answers: payload })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.error) throw new Error(data.error);
      reviewData = data;
      render();
    }).catch(function(err) {
      GS.toast(err.message || 'Submission failed', 'error');
      if (btn) { btn.disabled = false; btn.textContent = 'Finish & See Result'; }
    });
  }

  function renderReview() {
    var d = reviewData;
    var html = '';
    html += '<div class="card">';
    html += '<div class="result-hero">';
    html += '<h1 style="font-size:20px;margin-bottom:12px">Practice Complete</h1>';
    html += '<div class="result-score">' + d.correct + '<small> / ' + d.total + '</small></div>';
    html += '<div class="mt-1">Accuracy <b>' + d.accuracy + '%</b></div>';
    html += '</div>';
    html += '<div class="card-body" style="border-top:1px solid var(--border)">';
    d.review.forEach(function(r, i) {
      var cls = r.selected === null ? 'skipped' : r.isCorrect ? 'correct' : 'incorrect';
      var statusText = r.selected === null ? 'Skipped' : r.isCorrect ? 'Correct' : 'Incorrect';
      html += '<div class="review-item ' + cls + '">';
      html += '<div class="flex items-center justify-between mb-1"><span class="xs muted">Q' + (i + 1) + '</span><span class="badge ' + (cls === 'correct' ? 'badge-success' : cls === 'incorrect' ? 'badge-danger' : 'badge-neutral') + '">' + statusText + '</span></div>';
      html += '<div class="q-text" style="font-size:15px;margin-bottom:8px">' + r.question.text + '</div>';
      var letters = ['A', 'B', 'C', 'D'];
      r.question.options.forEach(function(opt, oi) {
        var ocls = 'review-opt ';
        if (oi === r.question.correctOption) ocls += 'is-correct ';
        if (oi === r.selected && !r.isCorrect) ocls += 'user-wrong ';
        html += '<div class="' + ocls + '">' + letters[oi] + '. ' + opt + '</div>';
      });
      if (r.question.explanation) html += '<div class="explanation"><b>Explanation:</b> ' + r.question.explanation + '</div>';
      html += '</div>';
    });
    html += '<div class="flex gap-2 mt-3">';
    html += '<a href="/practice" class="btn btn-outline">Practice More</a>';
    html += '<a href="/tests" class="btn btn-primary">Take a Test</a>';
    html += '</div>';
    html += '</div></div>';
    area.innerHTML = html;
    document.getElementById('progressBar').style.width = '100%';
    document.getElementById('progressLabel').textContent = 'Complete';
    window.scrollTo(0, 0);
  }

  render();
})();
</script>
<%- include('../partials/footer') %>
