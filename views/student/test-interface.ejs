<%- include('../partials/head') %>
<body class="exam-shell">
<div class="exam-topbar">
  <div class="exam-topbar-inner">
    <div class="flex items-center gap-2">
      <span class="brand-mark" style="width:30px;height:30px;border-radius:8px"><i data-lucide="trophy"></i></span>
      <div>
        <div class="exam-title"><%= test.title %></div>
        <div class="xs muted"><%= appName %> · <%= test.type.replace(/_/g, ' ') %></div>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <span class="small muted no-print" id="networkNote"></span>
      <span class="exam-timer" id="examTimer">--:--</span>
      <button type="button" class="btn btn-danger btn-sm no-print" id="submitBtn">Submit Test</button>
    </div>
  </div>
</div>

<div class="exam-layout">
  <div class="exam-questions">
    <% var flat = []; sections.forEach(function(s, si) { s.questions.forEach(function(q) { flat.push({ q: q, section: s.name }); }); }); %>
    <% flat.forEach(function(item, idx) { %>
      <div class="exam-question" data-q-index="<%= idx %>">
        <div class="q-number"><%= item.section %> · Question <%= idx + 1 %> of <%= flat.length %></div>
        <div class="q-text"><%= item.q.text %></div>
        <% if (item.q.type === 'sql') { %><span class="badge badge-info mb-2">SQL</span><% } %>
        <% ['A','B','C','D'].forEach(function(l, oi) { %>
          <div class="q-option" data-opt="<%= oi %>" data-q="<%= String(item.q._id) %>">
            <span class="opt-label"><%= l %>.</span><span><%= item.q.options[oi] %></span>
          </div>
        <% }) %>
        <div class="exam-nav">
          <button type="button" class="btn btn-outline" data-action="prev">Previous</button>
          <button type="button" class="btn btn-outline" data-action="clear">Clear Response</button>
          <button type="button" class="btn btn-outline" data-action="mark">Mark for Review</button>
          <button type="button" class="btn btn-primary" data-action="next">Next</button>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="exam-sidebar">
    <div class="exam-stats">
      <div class="exam-stat"><span>Answered</span><b id="countAnswered">0</b></div>
      <div class="exam-stat"><span>Not answered</span><b id="countUnanswered">0</b></div>
      <div class="exam-stat"><span>Marked for review</span><b id="countMarked">0</b></div>
    </div>
    <div>
      <div class="small fw-700 mb-1">Question Palette</div>
      <div class="palette-grid" id="palette"></div>
    </div>
    <div class="exam-legend">
      <span><span class="legend-swatch answered"></span> Answered</span>
      <span><span class="legend-swatch"></span> Not answered</span>
      <span><span class="legend-swatch marked"></span> Marked for review</span>
    </div>
    <button type="button" class="btn btn-danger btn-block" id="submitBtn2">Submit Test</button>
  </div>
</div>

<script>
(function () {
  var attemptId = <%- JSON.stringify(String(attemptId)) %>;
  var testId = <%- JSON.stringify(String(test._id)) %>;
  var durationMin = <%= test.durationMinutes %>;
  var questions = <%- JSON.stringify(flat.map(function(item) { return { id: String(item.q._id), section: item.section }; })) %>;

  var storageKey = 'gs_test_' + attemptId;
  var state = null;

  // Restore progress from localStorage (refresh protection)
  try {
    var saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
    if (saved && saved.startedAt) state = saved;
  } catch (e) {}

  if (!state) {
    fetch('/api/attempts/' + attemptId + '/resume')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { showSubmitError('Could not restore session: ' + data.error); return; }
        var answers = {};
        var marked = {};
        var flatLocal = [];
        (data.sections || []).forEach(function (s) {
          s.questions.forEach(function (q) {
            flatLocal.push({ id: String(q._id), section: s.name });
            if (q.selected !== null && q.selected !== undefined) answers[String(q._id)] = q.selected;
            if (q.isMarked) marked[String(q._id)] = true;
          });
        });
        state = { startedAt: new Date(data.startedAt).getTime(), answers: answers, marked: marked };
        if (flatLocal.length) { questions = flatLocal; buildPalette(); syncAll(); }
        localStorage.setItem(storageKey, JSON.stringify(state));
      })
      .catch(function () { showSubmitError('Could not restore session. Please refresh.'); });
  } else {
    buildPalette();
    syncAll();
  }

  var current = 0;
  var timerEl = document.getElementById('examTimer');
  var finished = false;

  function secondsLeft() {
    var now = Date.now();
    var end = state.startedAt + durationMin * 60 * 1000;
    return Math.max(0, Math.floor((end - now) / 1000));
  }

  function tick() {
    if (finished) return;
    var s = secondsLeft();
    var m = Math.floor(s / 60);
    var ss = String(s % 60).padStart(2, '0');
    timerEl.textContent = m + ':' + ss;
    if (s <= 60) timerEl.classList.add('danger');
    if (s <= 0) { autoSubmit(); }
  }

  function buildPalette() {
    var p = document.getElementById('palette');
    p.innerHTML = '';
    questions.forEach(function (q, i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'palette-btn';
      b.textContent = i + 1;
      b.dataset.index = i;
      b.addEventListener('click', function () { goTo(i); });
      p.appendChild(b);
    });
  }

  function syncAll() {
    updatePalette();
    updateCounts();
    updateCurrentQ();
    tick();
  }

  function updatePalette() {
    var btns = document.querySelectorAll('.palette-btn');
    questions.forEach(function (q, i) {
      var b = btns[i];
      if (!b) return;
      var has = state.answers[q.id] !== undefined;
      var marked = state.marked[q.id];
      b.className = 'palette-btn' + (has ? ' answered' : '') + (marked ? ' marked' : '') + (i === current ? ' current' : '');
    });
  }

  function updateCounts() {
    var answered = 0, marked = 0;
    questions.forEach(function (q) {
      if (state.answers[q.id] !== undefined) answered++;
      if (state.marked[q.id]) marked++;
    });
    document.getElementById('countAnswered').textContent = answered;
    document.getElementById('countUnanswered').textContent = questions.length - answered;
    document.getElementById('countMarked').textContent = marked;
  }

  function updateCurrentQ() {
    document.querySelectorAll('.exam-question').forEach(function (el) {
      el.classList.toggle('active', parseInt(el.dataset.qIndex, 10) === current);
    });
    questions.forEach(function (q, i) {
      var opts = document.querySelectorAll('.exam-question[data-q-index="' + i + '"] .q-option');
      opts.forEach(function (o) {
        var val = state.answers[q.id];
        o.classList.toggle('selected', val === parseInt(o.dataset.opt, 10));
      });
    });
    updatePalette();
    var qs = document.querySelectorAll('.exam-question');
    if (qs[current]) qs[current].scrollIntoView({ block: 'start', behavior: 'smooth' });
  }

  function goTo(i) { current = i; updateCurrentQ(); }

  document.addEventListener('click', function (e) {
    var action = e.target.closest('[data-action]');
    if (action) {
      var act = action.dataset.action;
      var q = questions[current];
      if (act === 'next') { current = Math.min(current + 1, questions.length - 1); updateCurrentQ(); }
      if (act === 'prev') { current = Math.max(current - 1, 0); updateCurrentQ(); }
      if (act === 'mark') { state.marked[q.id] = !state.marked[q.id]; save(); updateCounts(); updatePalette(); }
      if (act === 'clear') { delete state.answers[q.id]; save(); updateCounts(); updatePalette(); updateCurrentQ(); }
    }
    var opt = e.target.closest('.q-option');
    if (opt) {
      var qid = opt.dataset.q;
      var val = parseInt(opt.dataset.opt, 10);
      state.answers[qid] = val;
      save();
      updateCounts();
      updatePalette();
      updateCurrentQ();
    }
  });

  function save() {
    try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch (e) {}
    document.getElementById('networkNote').textContent = 'Progress saved locally';
  }

  function submitPayload() {
    return questions.map(function (q) {
      return { question: q.id, selected: state.answers[q.id] !== undefined ? state.answers[q.id] : null };
    });
  }

  function doSubmit() {
    if (finished) return;
    finished = true;
    timerEl.textContent = 'Submitting...';
    try { localStorage.removeItem(storageKey); } catch (e) {}
    fetch('/api/tests/' + testId + '/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ answers: submitPayload(), timeTaken: durationMin * 60 - secondsLeft() })
    }).then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (data.resultUrl) { window.location.href = data.resultUrl; return; } throw new Error(data.error); }
        window.location.href = data.resultUrl;
      })
      .catch(function (err) {
        showSubmitError(err.message || 'Submission failed. Try again.');
        finished = false;
        timerEl.textContent = '--:--'; tick();
      });
  }

  function autoSubmit() {
    doSubmit();
  }

  function showSubmitError(msg) {
    var el = document.getElementById('networkNote');
    el.textContent = msg;
    el.style.color = 'var(--danger)';
  }

  document.getElementById('submitBtn').addEventListener('click', function () {
    var answered = questions.filter(function (q) { return state.answers[q.id] !== undefined; }).length;
    if (!window.confirm('You have answered ' + answered + ' of ' + questions.length + ' questions. Submit now?')) return;
    doSubmit();
  });
  document.getElementById('submitBtn2').addEventListener('click', function () {
    if (!window.confirm('You have answered ' + questions.filter(function (q) { return state.answers[q.id] !== undefined; }).length + ' of ' + questions.length + ' questions. Submit now?')) return;
    doSubmit();
  });

  setInterval(tick, 1000);
  window.addEventListener('beforeunload', function (e) {
    if (!finished) { save(); e.preventDefault(); e.returnValue = ''; }
  });
})();
</script>
</body>
</html>
