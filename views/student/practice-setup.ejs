<%- include('../partials/head') %>
<%- include('../partials/header-app') %>
<main>
  <div class="app-main">
    <%- include('../partials/flash') %>
    <div class="page-head">
      <h1>Practice</h1>
      <p>Choose what to practice. There are <%= totalQuestions %> questions available - everything is free.</p>
    </div>

    <!-- Quick start form -->
    <form action="/practice/session" method="GET" class="card" style="margin-bottom:24px">
      <div class="filter-bar">
        <div class="form-group">
          <label>Subject</label>
          <select name="subject" class="form-control" id="subjectSelect">
            <option value="">All Subjects</option>
            <% subjects.forEach(function(s) { %>
              <option value="<%= s.slug %>" <%= selectedSubject === s.slug ? 'selected' : '' %>><%= s.name %> (<%= subjectCounts[s.slug] || 0 %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Topic</label>
          <select name="topic" class="form-control" id="topicSelect">
            <option value="">All Topics</option>
            <% topics.forEach(function(t) { %>
              <option value="<%= t.slug %>" data-subject="<%= t.subject?.slug || '' %>" <%= selectedTopic === t.slug ? 'selected' : '' %>><%= t.name %> (<%= t.questionCount %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Difficulty</label>
          <select name="difficulty" class="form-control">
            <option value="">All</option>
            <option value="easy" <%= selectedDifficulty === 'easy' ? 'selected' : '' %>>Easy</option>
            <option value="medium" <%= selectedDifficulty === 'medium' ? 'selected' : '' %>>Medium</option>
            <option value="hard" <%= selectedDifficulty === 'hard' ? 'selected' : '' %>>Hard</option>
          </select>
        </div>
        <div class="form-group">
          <label>Questions</label>
          <select name="count" class="form-control">
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="20" selected>20</option>
            <option value="30">30</option>
            <option value="50">50</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">Start Practice</button>
      </div>
      <div class="card-body" style="padding-top:0">
        <div class="checkbox-group">
          <input type="checkbox" name="unattempted" value="1" id="chkUnattempted">
          <label for="chkUnattempted">Unattempted only <span class="xs muted">(questions you haven't solved)</span></label>
        </div>
        <div class="checkbox-group">
          <input type="checkbox" name="bookmarked" value="1" id="chkBookmarked">
          <label for="chkBookmarked">Bookmarked only <span class="xs muted">(questions you saved)</span></label>
        </div>
        <div class="checkbox-group">
          <input type="checkbox" name="weak" value="1" id="chkWeak">
          <label for="chkWeak">Weak topics first <span class="xs muted">(topics where you often answer wrong)</span></label>
        </div>
      </div>
    </form>

    <!-- Subject Cards (Level 1) -->
    <h2 style="margin-bottom:16px">Browse by Subject</h2>
    <div class="grid grid-3" style="margin-bottom:32px">
      <% subjects.forEach(function(s) { %>
        <div class="card subject-expand-card" data-subject="<%= s.slug %>">
          <div class="card-body cursor-pointer" onclick="toggleSubjectTopics(this)">
            <div class="flex items-center gap-3">
              <span class="stat-icon" style="background:<%= s.color %>15;color:<%= s.color %>"><i data-lucide="<%= s.icon %>" style="width:22px;height:22px"></i></span>
              <div style="flex:1">
                <h3 style="margin:0;font-size:15px"><%= s.name %></h3>
                <p class="small muted" style="margin:0"><%= subjectCounts[s.slug] || 0 %> questions</p>
              </div>
              <i data-lucide="chevron-down" style="width:18px;height:18px" class="expand-icon"></i>
            </div>
          </div>
          <div class="card-body subject-topics" style="display:none;border-top:1px solid var(--border);padding-top:12px">
            <div style="display:grid;gap:6px">
              <% topics.filter(function(t) { return t.subject?.slug === s.slug && t.questionCount > 0; }).forEach(function(t) { %>
                <a href="/practice?subject=<%= s.slug %>&topic=<%= t.slug %>" class="flex items-center justify-between" style="padding:6px 10px;border-radius:6px;background:var(--surface);text-decoration:none;color:var(--text);font-size:14px">
                  <span><%= t.name %></span>
                  <span class="badge badge-info" style="font-size:11px"><%= t.questionCount %></span>
                </a>
              <% }) %>
            </div>
            <div class="mt-2 flex gap-2">
              <a href="/practice?subject=<%= s.slug %>&count=20" class="btn btn-primary btn-sm">Practice All</a>
              <a href="/practice?subject=<%= s.slug %>&difficulty=easy&count=10" class="btn btn-outline btn-sm">Easy</a>
              <a href="/practice?subject=<%= s.slug %>&difficulty=medium&count=10" class="btn btn-outline btn-sm">Medium</a>
              <a href="/practice?subject=<%= s.slug %>&difficulty=hard&count=10" class="btn btn-outline btn-sm">Hard</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</main>

<script>
(function () {
  var subject = document.getElementById('subjectSelect');
  var topic = document.getElementById('topicSelect');
  function filterTopics() {
    var val = subject.value;
    Array.prototype.forEach.call(topic.options, function (opt) {
      if (opt.value === '') { opt.style.display = ''; return; }
      opt.style.display = !val || opt.dataset.subject === val ? '' : 'none';
    });
    if (val && topic.value) {
      var sel = topic.options[topic.selectedIndex];
      if (sel.dataset.subject !== val) topic.value = '';
    }
  }
  subject.addEventListener('change', filterTopics);
  filterTopics();
})();

function toggleSubjectTopics(card) {
  var body = card.closest('.subject-expand-card');
  var topics = body.querySelector('.subject-topics');
  var icon = body.querySelector('.expand-icon');
  if (topics.style.display === 'none') {
    topics.style.display = '';
    if (icon) { icon.setAttribute('data-lucide', 'chevron-up'); lucide.createIcons(); }
  } else {
    topics.style.display = 'none';
    if (icon) { icon.setAttribute('data-lucide', 'chevron-down'); lucide.createIcons(); }
  }
}
</script>
<%- include('../partials/footer') %>
