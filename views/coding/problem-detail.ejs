<%- include('../partials/head') %>
<%- include('../partials/header-app') %>
<main>
  <div class="app-main" style="max-width:1000px">
    <%- include('../partials/flash') %>
    <div class="page-head">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3 flex-wrap">
          <a href="/coding" class="btn btn-ghost btn-sm">← Back</a>
          <h1><%= problem.title %></h1>
          <span class="badge badge-<%= problem.difficulty === 'easy' ? 'success' : problem.difficulty === 'medium' ? 'warning' : 'danger' %>"><%= problem.difficulty %></span>
          <span class="badge badge-neutral"><%= problem.category %></span>
        </div>
        <% if (typeof user !== 'undefined' && user) { %>
          <button class="btn btn-ghost btn-sm" data-bookmark data-item-type="coding_problem" data-item-id="<%= String(problem._id) %>" <%= bookmark ? 'style="color:var(--warning)"' : '' %>>
            <i data-lucide="bookmark" <%= bookmark ? 'fill="currentColor"' : '' %>></i> <%= bookmark ? 'Saved' : 'Save' %>
          </button>
        <% } %>
      </div>
      <p class="small muted mt-2"><%= submissions %> submissions · <%= (problem.companies || []).map(function(c) { return c.name; }).join(', ') || 'General practice' %></p>
    </div>

    <div class="grid grid-2" style="grid-template-columns:1.2fr 1fr;gap:24px">
      <div style="display:grid;gap:20px">
        <div class="card">
          <div class="card-header"><h2>Problem Statement</h2></div>
          <div class="card-body" style="font-size:14.5px;line-height:1.7">
            <p><%= problem.problemStatement %></p>
            <h3 style="font-size:15px" class="mt-3 mb-1">Examples</h3>
            <% (sampleTestCases || problem.examples || []).forEach(function(ex, i) { %>
              <div class="pre-block mb-2">
                <div><b>Example <%= i + 1 %></b></div>
                <div class="mt-1"><span class="muted">Input:</span> <%= ex.input %></div>
                <div><span class="muted">Output:</span> <%= ex.output %></div>
                <% if (ex.explanation) { %><div class="mt-1"><span class="muted">Explanation:</span> <%= ex.explanation %></div><% } %>
              </div>
            <% }) %>
            <% if (problem.constraints) { %>
              <h3 style="font-size:15px" class="mt-3 mb-1">Constraints</h3>
              <div class="pre-block"><%= problem.constraints %></div>
            <% } %>
            <% if (problem.concepts && problem.concepts.length) { %>
              <h3 style="font-size:15px" class="mt-3 mb-1">Concepts</h3>
              <div class="chip-list"><% problem.concepts.forEach(function(c) { %><span class="chip"><%= c %></span><% }) %></div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h2>Approach & Solution</h2></div>
          <div class="card-body" style="font-size:14.5px;line-height:1.7">
            <% if (problem.explanation) { %><p class="mb-2"><%= problem.explanation %></p><% } %>
            <% var langs = Object.keys(solutions || {}); %>
            <% if (langs.length && solutions[langs[0]].code) { %>
              <div class="solution-tabs" style="margin-bottom:12px">
                <% langs.forEach(function(lang, i) { %>
                  <% if (solutions[lang].code) { %>
                    <button class="btn btn-sm <%= i === 0 ? 'btn-primary' : 'btn-outline' %>" onclick="showSolution('<%= lang %>')"><%= lang.charAt(0).toUpperCase() + lang.slice(1) %></button>
                  <% } %>
                <% }) %>
              </div>
              <% langs.forEach(function(lang, i) { %>
                <div class="solution-panel" id="sol-<%= lang %>" style="display:<%= i === 0 ? '' : 'none' %>">
                  <% if (solutions[lang].approach) { %><p class="mb-2"><%= solutions[lang].approach %></p><% } %>
                  <div class="code-block"><%= solutions[lang].code %></div>
                </div>
              <% }) %>
            <% } else if (problem.solution) { %>
              <div class="code-block"><%= problem.solution %></div>
            <% } else { %>
              <p class="muted">No solutions available yet.</p>
            <% } %>
          </div>
        </div>
      </div>

      <div>
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="card" style="position:sticky;top:84px">
            <div class="card-header"><h2>Your Code</h2></div>
            <div class="card-body">
              <% if (!judge0Configured) { %>
                <div class="alert alert-warning" style="font-size:13px"><b>Note:</b> Code execution is not configured. Submissions are recorded for practice tracking.</div>
              <% } %>
              <div class="form-group">
                <label>Language</label>
                <select id="langSelect" class="form-control">
                  <option value="javascript">JavaScript</option>
                  <option value="python">Python</option>
                  <option value="java">Java</option>
                  <option value="cpp">C++</option>
                  <option value="c">C</option>
                </select>
              </div>
              <div class="form-group">
                <label>Code</label>
                <textarea id="codeArea" class="code-area" placeholder="Write your solution here..." style="min-height:280px;font-family:monospace;font-size:13px;line-height:1.5"></textarea>
              </div>
              <div class="flex gap-2">
                <button type="button" class="btn btn-outline" id="runBtn" style="flex:1">Run</button>
                <button type="button" class="btn btn-primary" id="submitBtn" style="flex:1">Submit</button>
              </div>
            </div>
          </div>

          <!-- Output Panel -->
          <div class="card mt-4" id="outputPanel" style="display:none">
            <div class="card-header"><h2>Output</h2></div>
            <div class="card-body">
              <div id="outputStatus" class="mb-2"></div>
              <div id="outputResults"></div>
            </div>
          </div>
        <% } else { %>
          <div class="card">
            <div class="empty-state">
              <i data-lucide="lock"></i>
              <h3>Log in to submit</h3>
              <p>Create a free account to submit solutions and track progress.</p>
              <a href="/login?next=/coding/<%= problem.slug %>" class="btn btn-primary mt-2">Log In</a>
            </div>
          </div>
        <% } %>

        <% if (mySubmissions.length) { %>
          <div class="card mt-4">
            <div class="card-header"><h2>My Submissions</h2><a href="/coding/my-attempts" class="btn-link btn-sm">All attempts</a></div>
            <div class="table-wrap">
              <table class="table">
                <thead><tr><th>Date</th><th>Language</th><th>Status</th><th>Result</th></tr></thead>
                <tbody>
                  <% mySubmissions.forEach(function(s) { %>
                    <tr>
                      <td class="muted small"><%= formatDate(s.createdAt) %></td>
                      <td class="small"><%= s.language %></td>
                      <td>
                        <% if (s.status === 'accepted') { %><span class="badge badge-success">Accepted</span>
                        <% } else if (s.status === 'wrong_answer') { %><span class="badge badge-danger">Wrong Answer</span>
                        <% } else if (s.status === 'compile_error') { %><span class="badge badge-warning">Compile Error</span>
                        <% } else if (s.status === 'runtime_error') { %><span class="badge badge-warning">Runtime Error</span>
                        <% } else if (s.status === 'tle') { %><span class="badge badge-warning">TLE</span>
                        <% } else { %><span class="badge badge-info"><%= s.status %></span><% } %>
                      </td>
                      <td class="small"><%= s.totalCases ? s.passedCases + '/' + s.totalCases : '—' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<script>
(function () {
  var runBtn = document.getElementById('runBtn');
  var submitBtn = document.getElementById('submitBtn');
  if (!runBtn || !submitBtn) return;

  function getCode() {
    return { code: document.getElementById('codeArea').value.trim(), language: document.getElementById('langSelect').value };
  }

  function showOutput(data) {
    var panel = document.getElementById('outputPanel');
    var status = document.getElementById('outputStatus');
    var results = document.getElementById('outputResults');
    panel.style.display = '';

    if (data.status) {
      var cls = data.status === 'accepted' ? 'badge-success' : data.status === 'pending' ? 'badge-info' : 'badge-danger';
      status.innerHTML = '<span class="badge ' + cls + '" style="font-size:14px;padding:8px 16px">' + data.status.toUpperCase() +
        (data.total ? ' — ' + data.passed + '/' + data.total + ' test cases passed' : '') + '</span>';
    }

    var html = '';
    (data.results || []).forEach(function(r, i) {
      html += '<div style="margin-bottom:12px;padding:12px;border-radius:8px;background:' + (r.passed ? 'var(--primary-light)' : '#fef2f2') + '">';
      html += '<div class="flex items-center justify-between mb-1">';
      html += '<span class="fw-600 small">Test Case ' + (i + 1) + '</span>';
      html += '<span class="badge ' + (r.passed ? 'badge-success' : 'badge-danger') + '">' + (r.passed ? 'Passed' : 'Failed') + '</span>';
      html += '</div>';
      html += '<div class="small" style="font-family:monospace">';
      html += '<div><b>Input:</b> <pre style="margin:4px 0;background:white;padding:6px;border-radius:4px;display:inline-block">' + escapeHtml(r.input) + '</pre></div>';
      html += '<div><b>Expected:</b> <pre style="margin:4px 0;background:white;padding:6px;border-radius:4px;display:inline-block">' + escapeHtml(r.expected) + '</pre></div>';
      html += '<div><b>Actual:</b> <pre style="margin:4px 0;background:white;padding:6px;border-radius:4px;display:inline-block">' + escapeHtml(r.actual || '') + '</pre></div>';
      if (r.stderr) html += '<div class="text-danger"><b>Stderr:</b> ' + escapeHtml(r.stderr) + '</div>';
      if (r.compile_output) html += '<div class="text-danger"><b>Compile:</b> ' + escapeHtml(r.compile_output) + '</div>';
      if (r.time) html += '<div class="muted">Time: ' + r.time + 's</div>';
      html += '</div></div>';
    });
    results.innerHTML = html || '<p class="muted">No results.</p>';
  }

  function escapeHtml(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s));
    return d.innerHTML;
  }

  function setLoading(btn, loading) {
    btn.disabled = loading;
    btn.dataset.origText = btn.dataset.origText || btn.textContent;
    btn.textContent = loading ? 'Running...' : btn.dataset.origText;
  }

  runBtn.addEventListener('click', function () {
    var d = getCode();
    if (!d.code) { GS.toast('Write some code first.', 'error'); return; }
    setLoading(runBtn, true);
    fetch('/coding/<%= problem.slug %>/run', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d)
    }).then(function(r) { return r.json(); })
      .then(function(data) {
        setLoading(runBtn, false);
        if (data.error) { GS.toast(data.error, 'error'); return; }
        showOutput(data);
        GS.toast('Run completed: ' + data.passed + '/' + data.total + ' passed', data.passed === data.total ? 'success' : 'error');
      })
      .catch(function() { setLoading(runBtn, false); GS.toast('Network error.', 'error'); });
  });

  submitBtn.addEventListener('click', function () {
    var d = getCode();
    if (!d.code) { GS.toast('Write some code first.', 'error'); return; }
    setLoading(submitBtn, true);
    fetch('/coding/<%= problem.slug %>/submit', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d)
    }).then(function(r) { return r.json(); })
      .then(function(data) {
        setLoading(submitBtn, false);
        if (data.error) { GS.toast(data.error, 'error'); return; }
        showOutput(data);
        GS.toast(data.status === 'accepted' ? 'All test cases passed!' : data.status.toUpperCase() + ': ' + data.passed + '/' + data.total + ' passed', data.status === 'accepted' ? 'success' : 'error');
      })
      .catch(function() { setLoading(submitBtn, false); GS.toast('Network error.', 'error'); });
  });
})();

function showSolution(lang) {
  document.querySelectorAll('.solution-panel').forEach(function(p) { p.style.display = 'none'; });
  document.getElementById('sol-' + lang).style.display = '';
  document.querySelectorAll('.solution-tabs .btn').forEach(function(b) { b.className = b.textContent.toLowerCase() === lang ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline'; });
}
</script>
<%- include('../partials/footer') %>
