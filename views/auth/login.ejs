<%- include('../partials/head') %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="card">
      <div class="card-body">
        <div class="flex items-center gap-3 mb-3">
          <span class="brand-mark"><i data-lucide="trophy"></i></span>
          <div>
            <div style="font-size:18px;font-weight:800"><%= appName %></div>
            <div class="xs muted"><%= appTagline %></div>
          </div>
        </div>
        <h1 class="auth-title">Log in</h1>
        <p class="auth-sub">Welcome back. Continue your preparation.</p>
        <%- include('../partials/flash') %>
        <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <form action="/login" method="POST">
          <input type="hidden" name="next" value="<%= next %>">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" required value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>">
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">Log In</button>
        </form>
        <div class="auth-foot">New to <%= appName %>? <a href="/signup">Create a free account</a></div>
      </div>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
