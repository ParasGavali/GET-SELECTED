<%- include('../partials/head') %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="card">
      <div class="card-body">
        <div class="flex items-center gap-3 mb-3">
          <span class="brand-mark"><i data-lucide="trophy"></i></span>
          <div>
            <div style="font-size:18px;font-weight:800"><%= appName %></div>
            <div class="xs muted"><%= appTagline %></div>
          </div>
        </div>
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-sub">Free forever. Full access to everything.</p>
        <%- include('../partials/flash') %>
        <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <form action="/signup" method="POST">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" class="form-control" required maxlength="80" placeholder="e.g. Ravi Kumar" value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>">
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" required placeholder="you@college.edu" value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>">
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label for="password">Password</label>
              <input type="password" id="password" name="password" class="form-control" required minlength="8" placeholder="Min 8 characters">
            </div>
            <div class="form-group">
              <label for="confirmPassword">Confirm Password</label>
              <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required minlength="8">
            </div>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label for="collegeSearch">College <span class="xs muted">(optional)</span></label>
              <div class="college-select-wrap">
                <input type="text" id="collegeSearch" class="form-control" placeholder="Search your college..." autocomplete="off" value="<%= typeof values !== 'undefined' && values.college ? values.college : '' %>">
                <input type="hidden" id="collegeId" name="collegeId" value="<%= typeof values !== 'undefined' && values.collegeId ? values.collegeId : '' %>">
                <input type="hidden" id="collegeName" name="college" value="<%= typeof values !== 'undefined' && values.college ? values.college : '' %>">
                <div id="collegeDropdown" class="college-dropdown" style="display:none"></div>
              </div>
            </div>
            <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:12px">
              <div class="form-group">
                <label for="branch">Branch</label>
                <input type="text" id="branch" name="branch" class="form-control" maxlength="80" placeholder="CSE" value="<%= typeof values !== 'undefined' && values.branch ? values.branch : '' %>">
              </div>
              <div class="form-group">
                <label for="year">Year</label>
                <select id="year" name="year" class="form-control">
                  <option value="">Select</option>
                  <option value="1">1st</option>
                  <option value="2">2nd</option>
                  <option value="3">3rd</option>
                  <option value="4">4th</option>
                  <option value="5">5th</option>
                </select>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">Sign Up Free</button>
        </form>
        <div class="auth-foot">Already have an account? <a href="/login">Log in</a></div>
      </div>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
<script>
(function() {
  var input = document.getElementById('collegeSearch');
  var hiddenId = document.getElementById('collegeId');
  var hiddenName = document.getElementById('collegeName');
  var dropdown = document.getElementById('collegeDropdown');
  var colleges = <%- JSON.stringify(typeof colleges !== 'undefined' ? colleges : []) %>;
  var debounce = null;

  input.addEventListener('focus', function() { filterColleges(input.value); });
  input.addEventListener('input', function() {
    hiddenId.value = '';
    hiddenName.value = input.value;
    clearTimeout(debounce);
    debounce = setTimeout(function() { filterColleges(input.value); }, 150);
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.college-select-wrap')) dropdown.style.display = 'none';
  });

  function filterColleges(query) {
    var q = (query || '').toLowerCase().trim();
    var matches = [];
    if (q.length > 0) {
      matches = colleges.filter(function(c) {
        return c.officialName.toLowerCase().indexOf(q) !== -1 ||
               c.shortName.toLowerCase().indexOf(q) !== -1 ||
               c.city.toLowerCase().indexOf(q) !== -1 ||
               (c.aliases && c.aliases.some(function(a) { return a.toLowerCase().indexOf(q) !== -1; }));
      }).slice(0, 8);
    }
    if (q === '' || matches.length > 0) {
      matches.push({ officialName: 'Other (Not Listed)', slug: 'other', shortName: 'Other', city: '', _isOther: true });
    }
    renderDropdown(matches);
  }

  function renderDropdown(items) {
    if (!items.length) { dropdown.style.display = 'none'; return; }
    dropdown.innerHTML = items.map(function(c) {
      return '<div class="college-option" data-id="' + (c._isOther ? '' : c._id || c.slug) + '" data-name="' + (c._isOther ? '' : c.officialName) + '">' +
        '<span class="college-option-name">' + c.officialName + '</span>' +
        (c.city ? '<span class="college-option-city">' + c.city + '</span>' : '') +
      '</div>';
    }).join('');
    dropdown.style.display = 'block';
    dropdown.querySelectorAll('.college-option').forEach(function(el) {
      el.addEventListener('click', function() {
        var id = el.getAttribute('data-id');
        var name = el.getAttribute('data-name');
        hiddenId.value = id;
        hiddenName.value = name || input.value;
        input.value = name || '';
        dropdown.style.display = 'none';
      });
    });
  }

  filterColleges(input.value);
})();
</script>
</body>
</html>
