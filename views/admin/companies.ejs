<%- include('../partials/head') %>
<%- include('partials/header') %>
<main>
  <div class="app-main">
    <%- include('../partials/flash') %>
    <div class="page-head">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1>Companies</h1>
          <p><%= companies.length %> companies</p>
        </div>
        <a href="/admin/companies/new" class="btn btn-primary">+ New Company</a>
      </div>
    </div>

    <div class="card">
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Company</th><th>Focus areas</th><th>Order</th><th>Active</th><th style="width:110px"></th></tr></thead>
          <tbody>
            <% companies.forEach(function(c) { %>
              <tr>
                <td>
                  <div class="flex items-center gap-2">
                    <span class="company-logo" style="width:28px;height:28px;font-size:10px;background:<%= c.color %>"><%= c.shortName ? c.shortName.slice(0, 2).toUpperCase() : c.name.slice(0, 2).toUpperCase() %></span>
                    <a href="/companies/<%= c.slug %>"><b><%= c.name %></b></a>
                  </div>
                </td>
                <td class="small"><%= (c.focusAreas || []).slice(0, 4).join(', ') %></td>
                <td class="small"><%= c.order %></td>
                <td><span class="badge <%= c.isActive ? 'badge-success' : 'badge-neutral' %>"><%= c.isActive ? 'Active' : 'Inactive' %></span></td>
                <td>
                  <div class="flex items-center gap-1">
                    <a href="/admin/companies/<%= String(c._id) %>/edit" class="btn btn-ghost btn-sm" title="Edit"><i data-lucide="pencil" style="width:14px;height:14px"></i></a>
                  </div>
                </td>
              </tr>
            <% }) %>
            <% if (!companies.length) { %><tr><td colspan="5" class="muted small" style="text-align:center;padding:32px">No companies yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
