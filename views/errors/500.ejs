<%- include('../partials/head') %>
<header class="navbar"><div class="container"><div class="navbar-inner">
  <a href="/" class="navbar-brand"><span class="brand-mark"><i data-lucide="trophy"></i></span><span><%= appName %></span></a>
  <a href="/" class="btn btn-outline btn-sm">Back to Home</a>
</div></div></header>
<main>
  <div class="container" style="padding:80px 20px;text-align:center;max-width:520px">
    <div style="font-size:64px;font-weight:900;color:#fca5a5">500</div>
    <h1 style="font-size:22px;margin:8px 0">Something went wrong</h1>
    <p class="muted">An unexpected error occurred. Please try again.</p>
    <% if (typeof error !== 'undefined' && error) { %><pre class="pre-block mt-3" style="text-align:left"><%= error %></pre><% } %>
    <div style="margin-top:24px"><a href="/" class="btn btn-primary">Go to Home</a></div>
  </div>
</main>
<%- include('../partials/footer') %>
