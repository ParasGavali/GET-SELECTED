# GET SELECTED - environment variable reference
# Copy this file to .env and fill in real values. NEVER commit real secrets.

# Node environment (development | production)
NODE_ENV=development

# Port used by the server. Render injects this automatically in production.
PORT=5000

# MongoDB connection string (required)
# Local dev: mongodb://127.0.0.1:27017/getselected
# Atlas:     mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/getselected?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=

# Public base URL of the app (used for links/emails). 
BASE_URL=http://localhost:5000

# Optional AI performance analysis (any OpenAI-compatible chat completions API)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Code execution via Judge0 CE (Docker)
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# Admin account created by the seed script
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@getselected.in
ADMIN_PASSWORD=Admin@12345
